{
  "name": "freebuff-doctor",
  "version": "0.6.2",
  "description": "Diagnose and fix common Freebuff problems from your terminal: system checks, a searchable FAQ, a troubleshooting wizard, and redacted reports you can paste or hand to a helper.",
  "keywords": [
    "freebuff",
    "codebuff",
    "doctor",
    "diagnostics",
    "cli",
    "troubleshooting",
    "support"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fbdoc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "faq.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardFlp/freebuff-doctor.git"
  },
  "homepage": "https://github.com/RichardFlp/freebuff-doctor#readme",
  "bugs": {
    "url": "https://github.com/RichardFlp/freebuff-doctor/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "boxen": "^9.0.0",
    "commander": "^15.0.0",
    "fuse.js": "^7.5.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
